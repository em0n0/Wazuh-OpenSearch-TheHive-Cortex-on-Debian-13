#!/usr/bin/env bash
# soc-ips — operate the Suricata inline IPS installed by deploy-soc-stack.sh
#   soc-ips status
#   soc-ips mode [detect|prevent]     detect = log only, prevent = drop high-confidence rules
#   soc-ips update                    suricata-update + live rule reload
#   soc-ips panic-off                 remove the NFQUEUE hook NOW (traffic flows uninspected)
#   soc-ips panic-on                  re-install the NFQUEUE hook
#   soc-ips blocked [N]               last N blocked events (default 20)
#   soc-ips selftest                  prove the IPS drops (needs prevent mode + internet)
#   soc-ips allow <sid>               never drop this SID (alert only)
#   soc-ips drop  <sid>               always drop this SID
set -euo pipefail
D=/etc/suricata/soc-ips
EVE=/var/log/suricata/eve.json
MODEFILE=$D/mode
[[ $EUID -eq 0 ]] || { echo "run as root (sudo)"; exit 1; }

# Prevent-tier: curated, high-confidence ET Open groups. Everything else stays alert-only.
write_drop_conf() {
  if [[ "$(cat "$MODEFILE" 2>/dev/null || echo detect)" == "prevent" ]]; then
    {
      echo "# generated by soc-ips — prevent tier (edit drop.local instead)"
      for g in emerging-botcc.rules emerging-ciarmy.rules emerging-compromised.rules \
               emerging-drop.rules emerging-malware.rules emerging-mobile_malware.rules \
               emerging-exploit_kit.rules emerging-worm.rules emerging-dshield.rules; do
        echo "group:$g"
      done
      echo "9000001"   # selftest rule (local.rules)
      cat "$D/drop.local" 2>/dev/null || true
    } > "$D/drop.conf"
  else
    echo "# detect mode: nothing is dropped" > "$D/drop.conf"
    # SIDs the admin forced to drop still apply
    grep -v '^#' "$D/drop.local" 2>/dev/null >> "$D/drop.conf" || true
  fi
}

do_update() {
  write_drop_conf
  suricata-update --no-test --no-reload --local "$D/local.rules" \
    --drop-conf "$D/drop.conf" --enable-conf "$D/enable.conf" \
    --disable-conf "$D/disable.conf" --modify-conf "$D/modify.conf" 2>&1 | grep -v Warning | tail -8
  suricata -T -c /etc/suricata/soc-ips.yaml -l /tmp >/dev/null 2>&1 \
    || { echo "ERROR: new ruleset fails 'suricata -T' — NOT reloading (old rules stay active)"; suricata -T -c /etc/suricata/soc-ips.yaml -l /tmp 2>&1 | tail -5; exit 1; }
  if systemctl is-active --quiet suricata-ips; then
    kill -USR2 "$(systemctl show -p MainPID --value suricata-ips)" && echo "live rule reload sent"
  fi
}

case "${1:-status}" in
  status)
    echo "mode:        $(cat "$MODEFILE" 2>/dev/null || echo detect)"
    echo "suricata:    $(systemctl is-active suricata-ips)"
    echo "nft hook:    $(systemctl is-active soc-ips-nft)  (table: $(nft list tables 2>/dev/null | grep -c soc_ips) loaded)"
    echo "rules:       $(grep -vc '^#\|^$' /var/lib/suricata/rules/suricata.rules 2>/dev/null || echo 0) loaded, $(grep -c '^drop' /var/lib/suricata/rules/suricata.rules 2>/dev/null || echo 0) drop"
    echo "last update: $(stat -c %y /var/lib/suricata/rules/suricata.rules 2>/dev/null | cut -d. -f1)"
    echo "alerts 24h:  $(tail -n 200000 "$EVE" 2>/dev/null | grep -c '"event_type":"alert"' || true)"
    echo "blocked 24h: $(tail -n 200000 "$EVE" 2>/dev/null | grep -c '"action":"blocked"' || true)"
    ;;
  mode)
    m="${2:-}"
    [[ "$m" == detect || "$m" == prevent ]] || { echo "mode: $(cat "$MODEFILE" 2>/dev/null || echo detect)   (usage: soc-ips mode detect|prevent)"; exit 0; }
    echo "$m" > "$MODEFILE"; do_update; echo "mode is now: $m"
    ;;
  update) do_update ;;
  panic-off) systemctl stop soc-ips-nft; echo "NFQUEUE hook removed — traffic is NOT inspected. Re-enable: soc-ips panic-on" ;;
  panic-on)  systemctl start soc-ips-nft; echo "NFQUEUE hook restored" ;;
  blocked)
    n="${2:-20}"
    grep '"action":"blocked"' "$EVE" 2>/dev/null | tail -n "$n" \
      | jq -r '[.timestamp, .src_ip, "->", .dest_ip, .alert.signature] | join("  ")' ;;
  allow)
    [[ "${2:-}" =~ ^[0-9]+$ ]] || { echo "usage: soc-ips allow <sid>"; exit 1; }
    # alert-only override: modify drop->alert for this SID
    echo "${2} \"^drop\" \"alert\"" >> "$D/modify.conf"; do_update ;;
  drop)
    [[ "${2:-}" =~ ^[0-9]+$ ]] || { echo "usage: soc-ips drop <sid>"; exit 1; }
    echo "$2" >> "$D/drop.local"; do_update ;;
  selftest)
    [[ "$(cat "$MODEFILE" 2>/dev/null)" == prevent ]] || { echo "switch to prevent mode first: soc-ips mode prevent"; exit 1; }
    before=$(grep -c '"action":"blocked"' "$EVE" 2>/dev/null || true)
    # local rule 9000001 matches the harmless 'uid=0(root)' test page; in prevent mode it is dropped.
    timeout 10 curl -s -m 8 http://testmynids.org/uid/index.html -o /dev/null || true
    sleep 3
    after=$(grep -c '"action":"blocked"' "$EVE" 2>/dev/null || true)
    if (( after > before )); then echo "PASS: IPS blocked the test flow"; else
      echo "no new blocked event. Check: soc-ips status, 'nft list ruleset | grep queue', sid 9000001 is in rules"; exit 1; fi ;;
  *) sed -n 2,13p "$0"; exit 1 ;;
esac
